{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golden-thread.local/schemas/region.schema.json",
  "title": "Golden Thread region",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "title", "summary", "order", "accent", "outcomes"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 3, "maxLength": 80 },
    "short_title": { "type": "string", "minLength": 2, "maxLength": 30 },
    "summary": { "type": "string", "minLength": 20, "maxLength": 320 },
    "order": { "type": "integer", "minimum": 0 },
    "accent": {
      "type": "string",
      "enum": ["slate", "amber", "green", "blue", "violet", "rust", "teal", "rose"]
    },
    "icon": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "terrain": {
      "type": "string",
      "enum": ["mountain", "cave", "jungle", "ruins", "village", "library", "maze", "islands", "swamp", "plain"]
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "type": "string", "minLength": 10, "maxLength": 240 }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 80
    }
  }
}
