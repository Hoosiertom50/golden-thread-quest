{# U06 — "Have I assembled credible proof, and what remains?" #}
{% extends "layouts/base.html.j2" %}
{% from "components/state_badge.html.j2" import state_badge %}
{% from "components/proof_list.html.j2" import proof_list %}
{% from "components/reviewer_findings.html.j2" import reviewer_findings_panel %}
{% from "components/action.html.j2" import action_button %}
{% from "components/empty_state.html.j2" import empty_state %}

{% block main %}
<header class="page-heading">
  <p class="eyebrow">Evidence workspace</p>
  <h1>{{ quest.title }}</h1>
  <p>{{ page.description }}</p>
</header>

{% if not attempt_id %}
{{ empty_state('No attempt yet',
    'Start the quest to create an evidence package. Nothing is written to your repository until you do.',
    'Open the quest', quest.route, url) }}
{% else %}

{{ reviewer_findings_panel(reviewer_findings) }}

<div class="workbench">
  <div class="stack">
    {{ proof_list(required_proof, 'Required evidence', heading_level=2) }}
    {{ proof_list(optional_proof, 'Optional evidence', 'No optional evidence for this quest.', heading_level=2) }}

    {% if validators %}
    <section class="panel stack" aria-labelledby="validators-heading">
      <h2 id="validators-heading">Local validation</h2>
      <ul class="checklist">
        {% for validator in validators %}
        <li>
          <div class="card-header">
            <strong>{{ validator.display_name }}</strong>
            {% if validator.latest_outcome %}
            <span class="state state-{{ 'locally_validated' if validator.latest_outcome in ('pass', 'warning') else 'needs_changes' }}">{{ validator.latest_outcome | replace('_', ' ') }}</span>
            {% else %}
            <span class="state state-available">Not run</span>
            {% endif %}
          </div>
          {% if validator.latest_completed_at %}
          <p class="authority">Last run <time datetime="{{ validator.latest_completed_at }}" data-format>{{ validator.latest_completed_at }}</time>{% if validator.result_route %} · <a href="{{ url(validator.result_route) }}">see the result</a>{% endif %}</p>
          {% endif %}
          {% if not validator.available %}
          <p class="authority">{{ validator.unavailable_reason }}</p>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
      <p class="authority">A failing check is never a failed quest. It tells you what to fix, and your work is preserved.</p>
      {# C12 — the run control. Disabled without the service, with the reason stated, rather
         than a button that looks live and does nothing. #}
      {% for run in run_actions %}{{ action_button(run, url) }}{% endfor %}
    </section>
    {% endif %}

    {% if proof_document %}
    <section class="panel" aria-labelledby="proof-doc-heading">
      <h2 id="proof-doc-heading">PROOF.md</h2>
      <div class="prose">{{ proof_document | safe }}</div>
    </section>
    {% endif %}
  </div>

  <aside class="panel stack" aria-label="Attempt status and actions">
    <h2 class="visually-hidden">Attempt status and actions</h2>
    <div>{{ state_badge(quest.state, show_authority=true) }}</div>
    {# Round 17 L11: said only in the badge's tooltip here, visibly on the quest page. #}
    <p>{{ quest.state.explanation }}</p>
    {% if stale_local_validation %}
    {# Round 12 C4: the state is earned once and a failing re-run never unwinds it
       (ADR-017), so this is not a contradiction with "Last run" below — but it reads like
       one without this note. #}
    <p class="authority">This state was earned on an earlier passing run. The latest run of
      {{ stale_local_validation | join(', ') }} did not pass; see Local validation below.</p>
    {% endif %}
    {% if changed_after_approval %}
    {# Round 17 L5: the review page said this, and nothing linked to it once verified. #}
    <div class="alert alert-warning" role="status">
      <p><strong>Changed since approval.</strong> {% for path in changed_after_approval %}<code>{{ path }}</code>{% if not loop.last %}, {% endif %}{% endfor %} changed after the reviewer approved this. The approval stands, but it describes the evidence as it was then. <a href="{{ url(review_route) }}">See the review</a>.</p>
    </div>
    {% endif %}
    <dl class="definition-list">
      <dt>Attempt</dt><dd><code>{{ attempt_id }}</code></dd>
      {% if evidence_path %}<dt>Location</dt><dd><code>{{ evidence_path }}</code></dd>{% endif %}
    </dl>

    {% if secret_scan_clean is not none %}
    {% if secret_scan_clean %}
    <div class="alert alert-success">
      <h3>No secrets detected</h3>
      <p>The scan found nothing secret-like. It is a safety net, not a guarantee.</p>
    </div>
    {% else %}
    <div class="alert alert-error">
      <h3>{{ 'Possible secret in your evidence' if 'secret' in scan_kinds else 'The scan could not check all of your evidence' }}</h3>
      {% if 'secret' in scan_kinds %}<p>Remove it before submitting. The scan reports the pattern and never the value.</p>{% endif %}
      {% if 'link' in scan_kinds %}<p>A file is a link that leads outside the evidence package, so it cannot be checked or shown. Replace it with a copy of the file.</p>{% endif %}
      {% if 'oversize' in scan_kinds %}<p>A file is too large for the scan to read. Trim it, or keep the full file out of the package and describe it in PROOF.md.</p>{% endif %}
      {% if 'unreadable' in scan_kinds %}<p>A file could not be read, so the scan could not check it. Fix its permissions, or take it out of the package.</p>{% endif %}
    </div>
    {% endif %}
    {% endif %}

    {# C19 — reports and advises. It never commits, pushes, merges or cleans. #}
    {# Round 15 L1: this whole panel is a build-time snapshot, not a live git read — a
       commit made after this build clears "Untracked", and an edit to an already-committed
       file after this build does not turn "Evidence committed" back to "not yet". Worded
       the way the review page's own change-detection notice already is (round 14 C4), so
       the wording never claims more than the snapshot it holds. #}
    <section aria-labelledby="git-heading">
      <h3 id="git-heading">Repository</h3>
      {% if git_summary.get('available') %}
      <dl class="definition-list">
        <dt>Branch</dt><dd>{{ git_summary.get('branch') or 'unknown' }}</dd>
        <dt>Upstream</dt><dd>{{ git_summary.get('upstream') or 'none set' }}</dd>
        <dt>Changed files</dt><dd>{{ git_summary.get('changed', 0) }}</dd>
        <dt>Untracked</dt><dd>{{ git_summary.get('untracked', 0) }}</dd>
        <dt>Evidence committed</dt>
        <dd>
          {% if git_summary.get('evidence_committed') is none %}unknown as of this build
          {% elif git_summary.get('evidence_committed') %}yes, as of this build
          {% else %}not yet, as of this build{% endif %}
        </dd>
      </dl>
      {% if git_summary.get('advice') %}<p>{{ git_summary.get('advice') }}</p>{% endif %}
      <p class="authority">This is what this page's build, <time datetime="{{ build.built_at }}" data-format>{{ build.built_at }}</time>, found. It is not a live read — a commit, edit or revert made after this build will not show here until the site is rebuilt (any action rebuilds it, or run <code>make build</code>).</p>
      {% else %}
      <p class="authority">{{ git_summary.get('reason', 'Git status is unavailable here.') }}</p>
      {% endif %}
      <p class="authority">This panel only reports. Commit and push yourself.</p>
    </section>

    {% if actions | selectattr('id', 'equalto', 'check-for-review') | list %}
    <p class="authority">Waiting for a reviewer. You do not need to tell anyone: GitHub emails you when a decision is ready. Then click <strong>Check for my review</strong>.</p>
    {% endif %}
    {% for item in actions %}{{ action_button(item, url) }}{% endfor %}
  </aside>
</div>
{% endif %}
{% endblock %}
