# Copy to ~/.config/gtq-reviewer.env. Every line is optional.
# off | shadow (the default: labels and a ping, writes nothing to a participant) | live
PILOT_AI_REVIEW_MODE=shadow
# Off by default. Set N to send one approval in N to a person anyway.
#PILOT_AI_SAMPLE_EVERY=5
#PILOT_AI_MODEL=claude-opus-5-5
# Secret that picks which approvals are sampled. Any long random string.
#PILOT_AI_SAMPLE_SALT=
# An ntfy topic URL, for "needs a person" and shadow verdicts.
#NTFY_URL=
# Optional: a GitHub token for the push, scoped to the program repository only (Contents and Pull
# requests: read and write). Absent, the server's own `gh` login is used, which is much broader.
#PILOT_BOT_TOKEN=
